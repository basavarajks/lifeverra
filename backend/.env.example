# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file to version control.

# --- Core -------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for the admin/doctor-verification dashboard. Choose a strong,
# unique password — this is not a demo value.
ADMIN_PASSWORD=

DATABASE_URL=sqlite:///./lifeverra.db
# For PostgreSQL (recommended for anything beyond local testing - e.g. a
# free Supabase or Neon project), use the connection string they give you,
# e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Both "postgres://" and "postgresql://" prefixes are accepted.

# Comma-separated list of allowed frontend origins in production, e.g.
# CORS_ORIGINS=https://lifeverra.app,https://app.lifeverra.app
# Leave unset (or "*") for local development only.
CORS_ORIGINS=*

# --- Maps / Places (optional) ------------------------------------------
# If set, live hospital search blends in real-time Google Places results
# alongside the built-in verified hospital directory. Without it, the app
# uses only the local directory (still fully functional).
GOOGLE_MAPS_API_KEY=

# --- Google Sign-In (patient login) ---------------------------------------
# OAuth 2.0 Web Client ID from https://console.cloud.google.com/apis/credentials
# ("Create Credentials" -> "OAuth client ID" -> "Web application"). Add both
# http://localhost:8000 and your Cloudflare tunnel URL as "Authorized
# JavaScript origins". Leave blank to hide the Google button and use email +
# password only.
GOOGLE_CLIENT_ID=
